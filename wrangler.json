{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "together-neu",
  "main": "./worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "CORE", "class_name": "TogetherCore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TogetherCore"] }]
}
